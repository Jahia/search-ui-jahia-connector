{
  // Type-checking config: covers the sources *and* the specs. `tsconfig.build.json` narrows this to
  // the sources and turns on emit — see the `typecheck` and `build` scripts.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],           // DOM: the connector uses fetch / Headers
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,

    "noEmit": true,

    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,       // keep import/export exactly as written — no CJS interop rewriting
    "resolveJsonModule": true,

    // vitest/globals: the specs use describe/it/expect/vi as globals.
    // node: the specs stub `global.fetch` / `global.Headers`.
    "types": ["vitest/globals", "node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
