{
  "name": "@jahia/search-ui-jahia-connector",
  "version": "3.0.0",
  "description": "A Search UI connector for Jahia GraphQL Search API",
  "license": "MIT",
  "author": "Jahia Team",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jahia/search-ui-jahia-connector.git"
  },
  "bugs": {
    "url": "https://github.com/Jahia/search-ui-jahia-connector/issues"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "yarn clean && yarn build && yarn test"
  },
  "dependencies": {
    "graphql": "^17.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
