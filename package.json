{
  "name": "@jahia/search-ui-jahia-connector",
  "version": "2.0.17",
  "description": "A Search UI connector for Jahia GraphQL Search API",
  "bugs": {
    "url": "https://github.com/Jahia/search-ui-jahia-connector/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jahia/search-ui-jahia-connector.git"
  },
  "license": "MIT",
  "author": "Jahia Team",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
