    "graphql": "^17.0.2"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "oxlint": "^1.76.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
